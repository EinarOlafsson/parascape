[Unit]
Description=Observe ParaScape work activity and session boundaries

[Service]
Type=oneshot
WorkingDirectory=/media/carruthers/mnt3/claude/repo/parascape
ExecStart=/usr/bin/python3 /media/carruthers/mnt3/claude/repo/parascape/scripts/work_watchdog.py check
MemoryMax=128M
TimeoutStartSec=30
NoNewPrivileges=true
UMask=0077
